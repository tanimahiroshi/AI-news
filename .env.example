# Google Chat — スペースの Incoming Webhook URL（chat.googleapis.com/v1/spaces/...）
GOOGLE_CHAT_WEBHOOK_URL=

# Jina Reader — jina.ai のダッシュボードから取得
JINA_API_KEY=

# Gemini — aistudio.google.com から取得
GEMINI_API_KEY=

# モックルート（true にすると RSS を読まず fixtures/sample-news.json を使う）
USE_SAMPLE_DATA=false

# 任意: schedule.lookbackHours を上書き（ローカル検証など）
# NEWS_LOOKBACK_HOURS=96
